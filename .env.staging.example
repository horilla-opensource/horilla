# Copy to .env.staging, keep that file outside source control, and replace every
# REPLACE_* value. The readiness command intentionally rejects placeholder values.
HYDRA_ENVIRONMENT=staging
COMPOSE_PROJECT_NAME=hydra-staging
HYDRA_DEPLOYMENT_REVISION=REPLACE_WITH_GIT_SHA_OR_RELEASE_ID
HYDRA_DISABLE_SCHEDULERS=True
HYDRA_ALLOW_WEB_DATABASE_INITIALIZATION=False
HYDRA_REQUIRE_POSTGRES=True
HYDRA_READINESS_REQUIRE_STATIC=True

DEBUG=False
SECRET_KEY=REPLACE_WITH_AT_LEAST_50_RANDOM_CHARACTERS
ALLOWED_HOSTS=staging.example.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://staging.example.com
TIME_ZONE=Europe/Warsaw

POSTGRES_DB=hydra
POSTGRES_USER=hydra_admin
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ADMIN_DATABASE_PASSWORD
HYDRA_DB_USER=hydra_app
HYDRA_DB_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_APP_PASSWORD
DB_CONN_MAX_AGE=60

STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/var/lib/hydra/media
HYDRA_PRIVATE_MEDIA_ROOT=/var/lib/hydra/private
HYDRA_PRIVATE_DOCUMENT_MAX_BYTES=10485760
HYDRA_BACKUP_ROOT=/backups
HYDRA_BACKUP_HOST_PATH=./backups

HYDRA_PORTAL_URL=https://oleksandrkiris.github.io/citronex-hydra-project/
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

HYDRA_HTTP_PORT=8000
HYDRA_IMAGE=hydra-app:staging
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
